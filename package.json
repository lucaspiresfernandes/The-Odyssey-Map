{
	"name": "the-odyssey-map",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bun scripts/run.ts dev",
		"dev:lan": "bun scripts/run.ts dev --lan",
		"build": "bun run --bun vite build",
		"start": "bun scripts/run.ts start",
		"start:lan": "bun scripts/run.ts start --lan",
		"seed": "bun scripts/seed.ts",
		"db:generate": "drizzle-kit generate",
		"test": "bun run check && bun test src",
		"test:e2e": "bun run build && bun scripts/e2e.ts",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@sveltejs/adapter-bun": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.5",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"qrcode-generator": "^2.0.4",
		"sharp": "^0.35.5"
	}
}
