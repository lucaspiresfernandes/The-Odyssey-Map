# Copy this file to .env. `bun run dev` and `bun run start` read it, and a
# variable already set in the shell wins over the file.

# Where the app listens. 127.0.0.1 is this machine only, which is what you want
# behind a reverse proxy. 0.0.0.0 is every network, for players on your Wi-Fi
# (the same as adding --lan). Ports below 1024 need root on Linux.
HOST=127.0.0.1

# Port of the app, in development and in production.
PORT=5173

# Port of the WebSocket server that runs beside the app.
WS_PORT=3001

# Everything below is optional.

# Where the SQLite database and uploaded map images live.
# DATA_DIR=data

# Where the database is, when it is not the file in DATA_DIR. The scheme picks
# the driver: `file:` is a SQLite file on this machine. See "Keeping the data
# somewhere else" in the README.
# DATABASE_URL=file:data/odyssey.db

# Where the pictures are kept, when it is not DATA_DIR. The scheme picks the
# storage: `file:` is a folder on this machine.
# STORAGE_URL=file:data

# How the two servers find and trust each other. APP_URL is where the
# WebSocket server forwards requests to the app; it follows PORT unless set.
# BRIDGE_SECRET is any long random string, the same for both servers; left
# blank, a new one is made on every start.
# APP_URL=http://127.0.0.1:5173
# BRIDGE_SECRET=

# Full WebSocket URL, for when a reverse proxy puts both servers on one origin.
# PUBLIC_WS_URL=wss://maps.example.com/live

# Public address of the app. Needed in production behind a proxy, and used by
# the WebSocket server to decide which pages may connect.
# ORIGIN=https://maps.example.com
